{
  "name": "contentful-sidekick",
  "version": "2.1.0",
  "description": "Chrome Extension that enables inline editing for websites created in Contentful",
  "main": "index.js",
  "browserslist": [
    "last 1 Chrome versions"
  ],
  "scripts": {
    "test": "jest tests/*.test.js",
    "build:clean": "npx rimraf dist",
    "build:chrome": "pnpm run build:clean && webpack --progress --config webpack/webpack.config.chrome.js",
    "dev:webpack": "pnpm run build:clean && webpack --watch --progress --config webpack/webpack.config.chrome.js",
    "dev:server": "node webpack/dev-server.js",
    "dev": "concurrently \"pnpm run dev:webpack\" \"pnpm run dev:server\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bradtaylorsf/contentful-sidekick.git"
  },
  "keywords": [
    "contentful",
    "chrome",
    "cms"
  ],
  "author": "Brad Taylor <bradtaylorsf@gmail.com>",
  "license": "GPL-1.0-or-later",
  "bugs": {
    "url": "https://github.com/bradtaylorsf/contentful-sidekick/issues"
  },
  "homepage": "https://github.com/bradtaylorsf/contentful-sidekick#readme",
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^5.15.12",
    "@mui/material": "^5.15.12",
    "@mui/system": "^5.15.12",
    "@mui/x-tree-view": "^7.28.1",
    "aai-embed": "~2.1.2",
    "common-tags": "^1.8.2",
    "contentful": "^11.5.10",
    "contentful-management": "11.48.1",
    "imurmurhash": "^0.1.4",
    "jquery": "^3.7.1",
    "lodash": "^4.17.21",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "regenerator-runtime": "^0.14.1",
    "scheduler": "^0.23.0",
    "use-context-selector": "^2.0.0",
    "uuid": "^9.0.1",
    "webpack": "^5.90.3",
    "webpack-merge": "^5.10.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/eslint-parser": "^7.23.10",
    "@babel/plugin-transform-private-property-in-object": "^7.24.0",
    "@babel/plugin-transform-runtime": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "@last-rev/generator": "^1.0.8",
    "@types/chrome": "^0.0.260",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.10.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-webpack-plugin": "^4.0.1",
    "file-loader": "^6.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
